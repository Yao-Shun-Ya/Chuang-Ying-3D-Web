# ================= 创影3D 后端环境配置 =================
# 复制本文件为 server/.env 并按需修改（.env 已被 .gitignore 排除，不会提交）。
# 首次运行 npm start 时，scripts/ensure-pg.js 会：
#   1) 不存在 .env 时自动生成本机随机密码并写回此配置；
#   2) 检测不到可用的 PostgreSQL 时，自动使用本机 PG 二进制初始化内嵌实例（server/.pgdata）；
#   3) 创建角色与数据库 campusprint；
# 一句话：开箱即用，无需任何手工数据库操作。

# ---- 数据库（PostgreSQL，生产级） ----
# 对接外部 PostgreSQL 时修改以下配置；本地自动初始化场景保持默认即可
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=campusapp
PG_PASSWORD=
PG_DATABASE=campusprint
# TLS 连接（远程云库通常需要 true）
PG_SSL=false
PG_POOL_MAX=20
PG_TZ=Asia/Shanghai

# ---- 安全 ----
# 生产环境（NODE_ENV=production）必须显式配置 ≥16 位随机值；开发环境可用内置默认
JWT_SECRET=
# JWT 有效期（默认 7 天）
JWT_EXPIRES_IN=7d
# CORS 白名单（逗号分隔），生产环境建议显式配置前端域名
CORS_ORIGINS=http://localhost:8732

# ---- 邮箱验证码（安全策略参见 README「安全机制」章节） ----
EMAIL_CODE_TTL=5
EMAIL_CODE_RESEND_COOLDOWN=60
EMAIL_CODE_MAX_SEND=5
EMAIL_CODE_MAX_ATTEMPTS=5

# ---- SMTP（不配置则验证码输出到后端控制台，演示模式） ----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- 打印回调（线下主机对接；生产环境必须配置 PRINT_CALLBACK_SECRET） ----
PRINT_CALLBACK_URL=
PRINT_CALLBACK_SECRET=